openapi: 3.0.3
info:
  title: 309_Postman_API Final
  description: >-
    This API collection provides endpoints for **user management, flight
    searching, hotel management, and booking services**. It enables users to
    **register, log in, manage their profiles, search for flights, manage
    hotels, and book or cancel room reservations**.


    **Setup Required:**  

    This collection uses environment variables. Before running requests, please
    create an environment in Postman and assign it to the collection. The routes
    to add images may require the you to manually add an image yourself.
  version: 1.0.0
  contact: {}
servers:
  - url: http://localhost
paths:
  /api/auth/register:
    post:
      tags:
        - Authentication
      summary: Register
      description: >-
        This route is used to register a new account. Returns the registered
        user's details.
      operationId: register
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                email:
                  type: string
                  example: john.doe@gmail.com
                firstName:
                  type: string
                  example: John
                lastName:
                  type: string
                  example: Doe
                password:
                  type: string
                  example: password
                phoneNumber:
                  type: string
                  example: '1234567890'
            examples:
              Register:
                value:
                  email: john.doe@gmail.com
                  firstName: John
                  lastName: Doe
                  password: password
                  phoneNumber: '1234567890'
      responses:
        '200':
          description: Register Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 03:26:24 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  email:
                    type: string
                    example: john.doe@gmail.com
                  firstName:
                    type: string
                    example: John
                  lastName:
                    type: string
                    example: Doe
                  phoneNumber:
                    type: string
                    example: '1234567890'
                  profilePic:
                    nullable: true
                    example: null
                  userId:
                    type: string
                    example: cm7y7rnhr0000u7ik6y8knqmb
              examples:
                Register Response:
                  value:
                    email: john.doe@gmail.com
                    firstName: John
                    lastName: Doe
                    phoneNumber: '1234567890'
                    profilePic: null
                    userId: cm7y7rnhr0000u7ik6y8knqmb
  /api/auth/login:
    post:
      tags:
        - Authentication
      summary: Login
      description: >-
        This route is used to login a user. It will return the accessToken and
        refreshToken.
      operationId: login
      parameters:
        - name: x-api-key
          in: header
          schema:
            type: string
            example: 660fd2753857f40781e914d56c15606bd4389995d302afb3147ed497def73da1
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                email:
                  type: string
                  example: john.doe@gmail.com
                password:
                  type: string
                  example: password
            examples:
              Login:
                value:
                  email: john.doe@gmail.com
                  password: password
      responses:
        '200':
          description: Login Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 03:27:10 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  accessToken:
                    type: string
                    example: >-
                      eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjbTd5N3JuaHIwMDAwdTdpazZ5OGtucW1iIiwiZW1haWwiOiJqb2huLmRvZUBnbWFpbC5jb20iLCJpYXQiOjE3NDEzMTgwMzAsImV4cCI6MTc0MTMxODkzMH0.Umdsfi_ct4t5-7UkKsdqyZcNIi98ZcpCXhwYMXRpG28
                  refreshToken:
                    type: string
                    example: >-
                      eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjbTd5N3JuaHIwMDAwdTdpazZ5OGtucW1iIiwiZW1haWwiOiJqb2huLmRvZUBnbWFpbC5jb20iLCJpYXQiOjE3NDEzMTgwMzAsImV4cCI6MTc0MTkyMjgzMH0.aNDfYOc7vLGLS-zYZdLPvG8wDZNDafTJlXFdTV1bb50
              examples:
                Login Response:
                  value:
                    accessToken: >-
                      eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjbTd5N3JuaHIwMDAwdTdpazZ5OGtucW1iIiwiZW1haWwiOiJqb2huLmRvZUBnbWFpbC5jb20iLCJpYXQiOjE3NDEzMTgwMzAsImV4cCI6MTc0MTMxODkzMH0.Umdsfi_ct4t5-7UkKsdqyZcNIi98ZcpCXhwYMXRpG28
                    refreshToken: >-
                      eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjbTd5N3JuaHIwMDAwdTdpazZ5OGtucW1iIiwiZW1haWwiOiJqb2huLmRvZUBnbWFpbC5jb20iLCJpYXQiOjE3NDEzMTgwMzAsImV4cCI6MTc0MTkyMjgzMH0.aNDfYOc7vLGLS-zYZdLPvG8wDZNDafTJlXFdTV1bb50
  /api/auth/refresh:
    post:
      tags:
        - Authentication
      summary: Refresh
      description: >-
        This route can be used when you have a valid refreshToken but your
        accessToken has expired. Upon recieving a valid refreshToken, it returns
        a new valid accessToken.
      operationId: refresh
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                refreshToken:
                  type: string
                  example: ''
            examples:
              Refresh:
                value:
                  refreshToken: ''
      responses:
        '200':
          description: Refresh Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 03:35:14 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  accessToken:
                    type: string
                    example: >-
                      eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjbTd5N3JuaHIwMDAwdTdpazZ5OGtucW1iIiwiZW1haWwiOiJqb2huLmRvZUBnbWFpbC5jb20iLCJpYXQiOjE3NDEzMTg1MTQsImV4cCI6MTc0MTMxOTQxNH0.grrWW689AtqSJBSaQ09GrRLnmFv_Pi0IJQNM2OyQaRg
              examples:
                Refresh Response:
                  value:
                    accessToken: >-
                      eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjbTd5N3JuaHIwMDAwdTdpazZ5OGtucW1iIiwiZW1haWwiOiJqb2huLmRvZUBnbWFpbC5jb20iLCJpYXQiOjE3NDEzMTg1MTQsImV4cCI6MTc0MTMxOTQxNH0.grrWW689AtqSJBSaQ09GrRLnmFv_Pi0IJQNM2OyQaRg
      security:
        - {}
  /api/auth/me:
    get:
      tags:
        - User
      summary: UserInfo
      description: >-
        This request is used to obtain the info on the current user. Requires a
        valid accessToken as authorization.
      operationId: userinfo
      responses:
        '200':
          description: UserInfo Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 03:36:45 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  email:
                    type: string
                    example: john.doe@gmail.com
                  firstName:
                    type: string
                    example: John
                  lastName:
                    type: string
                    example: Doe
                  phoneNumber:
                    type: string
                    example: '1234567890'
                  profilePic:
                    nullable: true
                    example: null
                  userId:
                    type: string
                    example: cm7y7rnhr0000u7ik6y8knqmb
              examples:
                UserInfo Response:
                  value:
                    email: john.doe@gmail.com
                    firstName: John
                    lastName: Doe
                    phoneNumber: '1234567890'
                    profilePic: null
                    userId: cm7y7rnhr0000u7ik6y8knqmb
      security:
        - {}
    post:
      tags:
        - User
      summary: UserUpdate
      description: >-
        This route is used to update a user with new information. Users can
        change their firstName, lastName, password, and email. At least one of
        the fields must be filled for an update, any fields not provided will
        not be provided. Requires a valid accessToken as authorization. Returns
        all the users information.
      operationId: userupdate
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                firstName:
                  type: string
                  example: Johnathan
                lastName:
                  type: string
                  example: Deer
            examples:
              UserUpdate:
                value:
                  firstName: Johnathan
                  lastName: Deer
      responses:
        '200':
          description: UserUpdate Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 03:37:57 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                    example: User updated successfully
                  user:
                    type: object
                    properties:
                      email:
                        type: string
                        example: john.doe@gmail.com
                      firstName:
                        type: string
                        example: Johnathan
                      lastName:
                        type: string
                        example: Deer
                      phoneNumber:
                        type: string
                        example: '1234567890'
                      userId:
                        type: string
                        example: cm7y7rnhr0000u7ik6y8knqmb
              examples:
                UserUpdate Response:
                  value:
                    message: User updated successfully
                    user:
                      email: john.doe@gmail.com
                      firstName: Johnathan
                      lastName: Deer
                      phoneNumber: '1234567890'
                      userId: cm7y7rnhr0000u7ik6y8knqmb
      security:
        - {}
  /api/auth/profilepic:
    post:
      tags:
        - User
      summary: ProfilePicUpdate
      description: >-
        This route is used to add a profile picture to the users account.
        Requires a valid accessToken as authorization.
      operationId: profilepicupdate
      requestBody:
        content:
          multipart/form-data:
            schema:
              type: object
              properties:
                image:
                  type: string
                  format: binary
      responses:
        '200':
          description: ''
      security:
        - {}
  /api/hotels/add:
    post:
      tags:
        - Hotels
      summary: Add Hotel
      description: >-
        This route is used to add a hotel to a users account. Will return
        information about the newly created hotel. Requires a valid accessToken
        as authorization.
      operationId: addHotel
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                address:
                  type: string
                  example: example addr
                location:
                  type: string
                  example: example loc
                name:
                  type: string
                  example: Example
                starRating:
                  type: number
                  example: 6
            examples:
              Add Hotel:
                value:
                  address: example addr
                  location: example loc
                  name: Example
                  starRating: 6
      responses:
        '200':
          description: Add Hotel
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 03:59:02 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  address:
                    type: string
                    example: example addr
                  hotelId:
                    type: string
                    example: cm7y8xmdg0006i0ns2xaimdjf
                  location:
                    type: string
                    example: example loc
                  name:
                    type: string
                    example: Example
                  ownerId:
                    type: string
                    example: cm7y8pkg30004i0nsd0646kux
                  pictures:
                    nullable: true
                    example: null
                  starRating:
                    type: number
                    example: 6
              examples:
                Add Hotel:
                  value:
                    address: example addr
                    hotelId: cm7y8xmdg0006i0ns2xaimdjf
                    location: example loc
                    name: Example
                    ownerId: cm7y8pkg30004i0nsd0646kux
                    pictures: null
                    starRating: 6
  /api/hotels/type:
    post:
      tags:
        - Hotels
      summary: Add Room Type
      description: >-
        This route is used to add a new room type. It must be associated with a
        specific hotelId. Returns information on the newly created room type.
        Requires a valid accessToken as authorization.
      operationId: addRoomType
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                amenities:
                  type: string
                  example: exampmle amenities
                hotelId:
                  type: string
                  example: cm7y8xmdg0006i0ns2xaimdjf
                pricePerNight:
                  type: number
                  example: 10.99
                typeName:
                  type: string
                  example: example type
            examples:
              Add Room Type:
                value:
                  amenities: exampmle amenities
                  hotelId: cm7y8xmdg0006i0ns2xaimdjf
                  pricePerNight: 10.99
                  typeName: example type
      responses:
        '200':
          description: Add Room Type
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 04:00:48 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  amenities:
                    type: string
                    example: exampmle amenities
                  hotelId:
                    type: string
                    example: cm7y8xmdg0006i0ns2xaimdjf
                  pricePerNight:
                    type: number
                    example: 10.99
                  typeName:
                    type: string
                    example: example type
              examples:
                Add Room Type:
                  value:
                    amenities: exampmle amenities
                    hotelId: cm7y8xmdg0006i0ns2xaimdjf
                    pricePerNight: 10.99
                    typeName: example type
  /api/hotels/rooms:
    post:
      tags:
        - Hotels
      summary: Add Room
      description: >-
        This route is used to add a new room to a hotel. It must be associated
        with both a hotel and room type. Returns information about the newly
        created room. Requires a valid accessToken as authorization.
      operationId: addRoom
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                hotelId:
                  type: string
                  example: cm7y8xmdg0006i0ns2xaimdjf
                roomNumber:
                  type: number
                  example: 1
                typeName:
                  type: string
                  example: example type
            examples:
              Add Room:
                value:
                  hotelId: cm7y8xmdg0006i0ns2xaimdjf
                  roomNumber: 1
                  typeName: example type
      responses:
        '200':
          description: Add Room
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 04:07:51 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  hotelId:
                    type: string
                    example: cm7y8xmdg0006i0ns2xaimdjf
                  roomId:
                    type: string
                    example: cm7y98yya000ai0nsnwd9htuc
                  roomNumber:
                    type: number
                    example: 1
                  typeName:
                    type: string
                    example: example type
              examples:
                Add Room:
                  value:
                    hotelId: cm7y8xmdg0006i0ns2xaimdjf
                    roomId: cm7y98yya000ai0nsnwd9htuc
                    roomNumber: 1
                    typeName: example type
  /api/hotels:
    get:
      tags:
        - Hotels
      summary: Get Hotels
      description: >-
        This route is used to get information on all available hotels within the
        specified time period and at the location. Various other queries can be
        used to search for hotels. Returns a list of hotels that fit the
        criteria.
      operationId: getHotels
      parameters:
        - name: checkInDate
          in: query
          schema:
            type: string
            example: '2025-03-01T14:00:00.000Z'
        - name: checkOutDate
          in: query
          schema:
            type: string
            example: '2025-03-08T14:00:00.000Z'
        - name: location
          in: query
          schema:
            type: string
            example: example loc
        - name: name
          in: query
          schema:
            type: string
            example: Example
        - name: starRating
          in: query
          schema:
            type: string
            example: '6'
        - name: priceRangeMax
          in: query
          schema:
            type: string
            example: '500'
        - name: priceRangeMin
          in: query
          schema:
            type: string
            example: '1'
      responses:
        '200':
          description: Get Hotels
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 04:08:36 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    address:
                      type: string
                      example: example addr
                    hotelId:
                      type: string
                      example: cm7y8xmdg0006i0ns2xaimdjf
                    location:
                      type: string
                      example: example loc
                    name:
                      type: string
                      example: Example
                    ownerId:
                      type: string
                      example: cm7y8pkg30004i0nsd0646kux
                    pictures:
                      nullable: true
                      example: null
                    rooms:
                      type: array
                      items:
                        type: object
                        properties:
                          hotelId:
                            type: string
                            example: cm7y8xmdg0006i0ns2xaimdjf
                          roomId:
                            type: string
                            example: cm7y98yya000ai0nsnwd9htuc
                          roomNumber:
                            type: number
                            example: 1
                          typeName:
                            type: string
                            example: example type
                      example:
                        - hotelId: cm7y8xmdg0006i0ns2xaimdjf
                          roomId: cm7y98yya000ai0nsnwd9htuc
                          roomNumber: 1
                          typeName: example type
                    starRating:
                      type: number
                      example: 6
                example:
                  - address: example addr
                    hotelId: cm7y8xmdg0006i0ns2xaimdjf
                    location: example loc
                    name: Example
                    ownerId: cm7y8pkg30004i0nsd0646kux
                    pictures: null
                    rooms:
                      - hotelId: cm7y8xmdg0006i0ns2xaimdjf
                        roomId: cm7y98yya000ai0nsnwd9htuc
                        roomNumber: 1
                        typeName: example type
                    starRating: 6
              examples:
                Get Hotels:
                  value:
                    - address: example addr
                      hotelId: cm7y8xmdg0006i0ns2xaimdjf
                      location: example loc
                      name: Example
                      ownerId: cm7y8pkg30004i0nsd0646kux
                      pictures: null
                      rooms:
                        - hotelId: cm7y8xmdg0006i0ns2xaimdjf
                          roomId: cm7y98yya000ai0nsnwd9htuc
                          roomNumber: 1
                          typeName: example type
                      starRating: 6
  /api/hotels/add/image:
    post:
      tags:
        - Hotels
      summary: Add Hotel Image
      description: >-
        This route is used to add/associate an image to a hotel. It returns a
        success message on success. Requires a valid accessToken as
        authorization.
      operationId: addHotelImage
      requestBody:
        content:
          multipart/form-data:
            schema:
              type: object
              properties:
                hotelId:
                  type: string
                  example: cm7y8xmdg0006i0ns2xaimdjf
                image:
                  type: string
                  format: binary
      responses:
        '201':
          description: Add Hotel Image
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 04:06:07 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                    example: Image sent successfully
              examples:
                Add Hotel Image:
                  value:
                    message: Image sent successfully
  /api/hotels/rooms/{roomId}:
    get:
      tags:
        - Hotels
      summary: Get Room By ID
      description: >-
        This route is used to get information on a specific room via the roomID.
        It returns information on the room specified.
      operationId: getRoomById
      responses:
        '200':
          description: Get Room By ID
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 04:14:29 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
