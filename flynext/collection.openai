                            duration: 830
                            flightNumber: MU1525
                            id: 9383ba28-71a6-4493-8849-a5d0c5ae7802
                            origin:
                              city: Shanghai
                              code: PVG
                              country: China
                              name: Shanghai Pudong International Airport
                            originId: 42fb9788-abab-4395-be2c-0ee891a161d6
                            price: 1123
                            status: SCHEDULED
                      lastName:
                        type: string
                        example: Deer
                      passportNumber:
                        type: string
                        example: AR0123678
                      status:
                        type: string
                        example: CONFIRMED
                      ticketNumber:
                        type: string
                        example: 43a3e495b1
              examples:
                CheckingFlightBooking Response:
                  value:
                    bookingDetails:
                      agencyId: 157a17e2-57c4-443e-973a-96acb455a645
                      bookingReference: 8D4625
