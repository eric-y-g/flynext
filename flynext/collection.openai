  /api/bookings/flight:
    get:
      tags:
        - Booking
      summary: CheckingFlightBooking
      description: >-
        This route is used to check a flight booking. It returns detailed
        information on the booking.
      operationId: checkingflightbooking
      parameters:
        - name: flightBookingId
          in: query
          schema:
            type: string
            example: '{{flightBookingId}}'
      responses:
        '200':
          description: CheckingFlightBooking Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 23:03:01 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  bookingDetails:
                    type: object
                    properties:
                      agencyId:
                        type: string
                        example: 157a17e2-57c4-443e-973a-96acb455a645
                      bookingReference:
                        type: string
                        example: 8D4625
                      createdAt:
                        type: string
                        example: '2025-03-07T23:01:09.231Z'
                      email:
                        type: string
                        example: john.doe@gmail.com
                      firstName:
                        type: string
                        example: Johnathan
                      flights:
                        type: array
                        items:
                          type: object
                          properties:
                            airline:
                              type: object
                              properties:
                                code:
                                  type: string
                                  example: MU
                                name:
                                  type: string
                                  example: China Eastern Airlines
                            arrivalTime:
                              type: string
                              example: '2024-11-19T02:30:00.000Z'
                            availableSeats:
                              type: number
                              example: 195
                            currency:
                              type: string
                              example: CAD
                            departureTime:
                              type: string
                              example: '2024-11-18T12:40:00.000Z'
                            destination:
                              type: object
                              properties:
                                city:
                                  type: string
                                  example: Zurich
                                code:
                                  type: string
                                  example: ZRH
                                country:
                                  type: string
                                  example: Switzerland
                                name:
                                  type: string
                                  example: Zurich Airport
                            destinationId:
                              type: string
                              example: 2bcb7925-96aa-4de8-9ec1-3622e954c0b6
                            duration:
                              type: number
                              example: 830
                            flightNumber:
                              type: string
                              example: MU1525
                            id:
                              type: string
                              example: 9383ba28-71a6-4493-8849-a5d0c5ae7802
                            origin:
                              type: object
                              properties:
                                city:
                                  type: string
                                  example: Shanghai
                                code:
                                  type: string
                                  example: PVG
                                country:
                                  type: string
                                  example: China
                                name:
                                  type: string
                                  example: Shanghai Pudong International Airport
                            originId:
                              type: string
                              example: 42fb9788-abab-4395-be2c-0ee891a161d6
                            price:
                              type: number
                              example: 1123
                            status:
                              type: string
                              example: SCHEDULED
                        example:
                          - airline:
                              code: MU
                              name: China Eastern Airlines
                            arrivalTime: '2024-11-19T02:30:00.000Z'
                            availableSeats: 195
                            currency: CAD
                            departureTime: '2024-11-18T12:40:00.000Z'
                            destination:
                              city: Zurich
                              code: ZRH
                              country: Switzerland
