    post:
      tags:
        - Booking
      summary: HotelBooking
      description: >-
        This route is used to book a hotel room. It requires the desired room
        type and date of stay. Returns information on the booking. Requires a
        valid accessToken as authentication.
      operationId: hotelbooking
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                checkInDate:
                  type: string
                  example: '2025-03-01T14:00:00.000Z'
                checkOutDate:
                  type: string
                  example: '2025-03-02T11:00:00.000Z'
                roomId:
                  type: string
                  example: ''
            examples:
              HotelBooking:
                value:
                  checkInDate: '2025-03-01T14:00:00.000Z'
                  checkOutDate: '2025-03-02T11:00:00.000Z'
                  roomId: ''
      responses:
        '200':
          description: HotelBooking
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Sat, 08 Mar 2025 22:00:30 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  checkInDate:
                    type: string
                    example: '2025-03-01T14:00:00.000Z'
                  checkOutDate:
                    type: string
                    example: '2025-03-02T11:00:00.000Z'
                  hotelId:
                    type: string
                    example: cm80e2jp60002i04cjcijxmtn
                  price:
                    type: number
                    example: 250
                  roomId:
                    type: string
                    example: cm80oeb4v000gi04c4qs85hq3
                  status:
                    type: string
                    example: reserved
                  typeName:
                    type: string
                    example: example two
                  userId:
                    type: string
                    example: cm80e2a610000i04c2ch35uu2
              examples:
                HotelBooking:
                  value:
                    checkInDate: '2025-03-01T14:00:00.000Z'
