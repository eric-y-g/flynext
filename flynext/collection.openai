  /api/hotels/booked:
    get:
      tags:
        - Booking
      summary: GetBookedHotelRooms
      description: >-
        This route is used to get information on booked hotel rooms. Returns
        information on the hotel booking requested. Requires a valid accessToken
        as authentication.
      operationId: getbookedhotelrooms
      parameters:
        - name: hotelId
          in: query
          schema:
            type: string
            example: '{{hotelId}}'
        - name: checkInDate
          in: query
          schema:
            type: string
            example: '2025-03-01T14:00:00.000Z'
        - name: checkOutDate
          in: query
          schema:
            type: string
            example: '2025-03-30T14:00:00.000Z'
        - name: roomType
          in: query
          schema:
            type: string
            example: example type
      responses:
        '200':
          description: GetBookedHotelRooms Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 18:56:54 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    checkInDate:
                      type: string
                      example: '2025-03-20T14:00:00.000Z'
                    checkOutDate:
                      type: string
                      example: '2025-03-25T11:00:00.000Z'
                    hotelId:
                      type: string
                      example: cm7y8xmdg0006i0ns2xaimdjf
                    roomId:
                      type: string
                      example: cm7y98yya000ai0nsnwd9htuc
                    typeName:
                      type: string
                      example: example type
                    userId:
                      type: string
                      example: cm7y8pkg30004i0nsd0646kux
                example:
                  - checkInDate: '2025-03-20T14:00:00.000Z'
                    checkOutDate: '2025-03-25T11:00:00.000Z'
                    hotelId: cm7y8xmdg0006i0ns2xaimdjf
                    roomId: cm7y98yya000ai0nsnwd9htuc
                    typeName: example type
                    userId: cm7y8pkg30004i0nsd0646kux
              examples:
                GetBookedHotelRooms Response:
                  value:
                    - checkInDate: '2025-03-20T14:00:00.000Z'
                      checkOutDate: '2025-03-25T11:00:00.000Z'
                      hotelId: cm7y8xmdg0006i0ns2xaimdjf
                      roomId: cm7y98yya000ai0nsnwd9htuc
                      typeName: example type
                      userId: cm7y8pkg30004i0nsd0646kux
  /api/bookings:
    get:
      tags:
        - Booking
      summary: GetAllBookings
      description: >-
        This route is used to get all the bookings that a user has made. It
        returns a list containing information on all their bookings, hotel and
        flights. Requires a valid accessToken as authentication.
      operationId: getallbookings
      responses:
        '200':
          description: GetAllBookings Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 23:20:47 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  flightBookings:
                    type: array
                    items:
                      type: object
                      properties:
                        bookingReference:
                          type: string
                          example: 8D4625
                        flightBookingId:
                          type: string
                          example: cm7zdqera0000u7s0r004j1mq
                        lastName:
                          type: string
                          example: Deer
                        userId:
                          type: string
                          example: cm7y7rnhr0000u7ik6y8knqmb
                    example:
                      - bookingReference: 8D4625
                        flightBookingId: cm7zdqera0000u7s0r004j1mq
                        lastName: Deer
                        userId: cm7y7rnhr0000u7ik6y8knqmb
                  hotelBooking:
                    type: array
                    items: {}
                    example: []
              examples:
                GetAllBookings Response:
                  value:
                    flightBookings:
                      - bookingReference: 8D4625
                        flightBookingId: cm7zdqera0000u7s0r004j1mq
                        lastName: Deer
                        userId: cm7y7rnhr0000u7ik6y8knqmb
                    hotelBooking: []
      security:
        - {}
  /api/flights/search:
    get:
      tags:
        - Flights
      summary: SearchFlightOneWay
      description: >-
        This route is used to find flights. It can be used for both oneWay
        flights and roundTrip flights. When used for oneWay, a there cannot be
        returnDate. It returns a list of all flights fitting the criteria.
      operationId: searchflightoneway
      parameters:
        - name: origin
          in: query
          schema:
            type: string
            example: Toronto
        - name: destination
          in: query
          schema:
            type: string
            example: Zurich
        - name: date
          in: query
          schema:
            type: string
            example: '2024-11-17'
        - name: tripType
          in: query
          schema:
            type: string
            example: oneWay
        - name: returnDate
          in: query
          schema:
            type: string
            example: '2024-11-18'
      responses:
        '200':
          description: SearchFlightOneWay Response / SearchFlightRoundTrip Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 22:47:19 GMT
