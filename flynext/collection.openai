                      status: CONFIRMED
                      ticketNumber: 43a3e495b1
    post:
      tags:
        - Booking
      summary: BookingFlight
      description: >-
        This route is used to book a flight. It returns barebones information on
        the bookings. Requires a valid accessToken as authentication.
      operationId: bookingflight
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                flightId:
                  type: string
                  example: 9383ba28-71a6-4493-8849-a5d0c5ae7802
                passportNumber:
                  type: string
                  example: AR0123678
            examples:
              BookingFlight:
                value:
                  flightId: 9383ba28-71a6-4493-8849-a5d0c5ae7802
                  passportNumber: AR0123678
      responses:
        '201':
          description: BookingFlight Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Fri, 07 Mar 2025 23:01:10 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  booking:
                    type: object
                    properties:
                      bookingReference:
                        type: string
                        example: 8D4625
                      flightBookingId:
                        type: string
                        example: cm7zdqera0000u7s0r004j1mq
                      lastName:
                        type: string
                        example: Deer
                      userId:
                        type: string
                        example: cm7y7rnhr0000u7ik6y8knqmb
                  message:
                    type: string
                    example: Flight booked successfully
              examples:
                BookingFlight Response:
                  value:
                    booking:
                      bookingReference: 8D4625
                      flightBookingId: cm7zdqera0000u7s0r004j1mq
                      lastName: Deer
                      userId: cm7y7rnhr0000u7ik6y8knqmb
                    message: Flight booked successfully
