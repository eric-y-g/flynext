  /api/notification:
    get:
      tags:
        - Notification
      summary: GetNotifications
      description: >-
        This route is used to get information on all a user's notifications.
        Requires a valid accessToken for authentication.
      operationId: getnotifications
      responses:
        '200':
          description: GetNotifications Response
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Sat, 08 Mar 2025 02:22:41 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    message:
                      type: string
                      example: >-
                        Your flight with booking reference 541C70 has been
                        successfully booked.
                    notificationId:
                      type: string
                      example: cm7zjk75x0007u7ysl849pefp
                    userId:
                      type: string
                      example: cm7zjjiwn0000u7ysqt4fvatn
                example:
                  - message: >-
                      Your flight with booking reference 541C70 has been
                      successfully booked.
                    notificationId: cm7zjk75x0007u7ysl849pefp
                    userId: cm7zjjiwn0000u7ysqt4fvatn
                  - message: Someone has booked your hotel.
                    notificationId: cm7zjkamr0009u7ys6tec5spd
                    userId: cm7zjjiwn0000u7ysqt4fvatn
              examples:
                GetNotifications Response:
                  value:
                    - message: >-
                        Your flight with booking reference 541C70 has been
                        successfully booked.
                      notificationId: cm7zjk75x0007u7ysl849pefp
                      userId: cm7zjjiwn0000u7ysqt4fvatn
                    - message: Someone has booked your hotel.
                      notificationId: cm7zjkamr0009u7ys6tec5spd
                      userId: cm7zjjiwn0000u7ysqt4fvatn
      security:
        - {}
    delete:
      tags:
        - Notification
      summary: DeleteNotification
      description: >-
        This route is used to delete a user's notification. Requires a valid
        accessToken for authentication.
      operationId: deletenotification
      parameters:
        - name: notificationId
          in: query
          schema:
            type: string
            example: '{{firstNotificationId}}'
      responses:
        '200':
          description: DeleteNotification
          headers:
            Connection:
              schema:
                type: string
                example: keep-alive
            Date:
              schema:
                type: string
                example: Sat, 08 Mar 2025 02:30:48 GMT
            Keep-Alive:
              schema:
                type: string
                example: timeout=5
            Transfer-Encoding:
              schema:
                type: string
                example: chunked
            vary:
              schema:
                type: string
                example: >-
                  RSC, Next-Router-State-Tree, Next-Router-Prefetch,
                  Next-Router-Segment-Prefetch
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                    example: Notification deleted successfully
              examples:
                DeleteNotification:
                  value:
                    message: Notification deleted successfully
      security:
        - {}
components:
  securitySchemes: {}
tags:
  - name: Authentication
    description: >-
      Here we have the requests on how to register an account. Login to recieve
      an access token and refresh token. As well a refresh path to aquire a new
      access token given an authentication token.
  - name: User
    description: >-
      Here contains methods for getting the user information. You must have the
      correct access token. We also have methods to update user information, you
      must have at least one field to update, a user can't change/update their
      email. Finally, we have a way to change/upload a profile picture for the
      user.
  - name: Hotels
    description: >-
      These routes are for users to manipulate, add, and manage their hotels and
      their rooms.
  - name: Cart
    description: >-
      Here contains the routes that are used for adding/removing/checking items
      in the user's cart
  - name: Booking
    description: >-
      This section contains all the routes used to book flights and hotels, as
      well as any routes to view your bookings.
  - name: Flights
  - name: Notification
    description: This folder contains the methods regarding notifications.
